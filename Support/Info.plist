<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ConvertAll</string>
	<key>CFBundleExecutable</key>
	<string>ConvertAll</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>app.convertall.ConvertAll</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ConvertAll</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- No Dock icon / menu bar: the app lives in the floating chip. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 ConvertAll</string>

	<!-- Right-click › Open With › ConvertAll for every supported image type. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>org.webmproject.webp</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.avif</string>
				<string>com.compuserve.gif</string>
				<string>public.tiff</string>
				<string>com.microsoft.bmp</string>
				<string>com.microsoft.ico</string>
				<string>com.truevision.tga-image</string>
				<string>public.pbm</string>
				<string>public.pgm</string>
				<string>public.ppm</string>
				<string>public.pnm</string>
				<string>org.qoiformat.qoi</string>
				<string>com.ilm.openexr-image</string>
				<string>public.svg-image</string>
			</array>
		</dict>
	</array>

	<!-- macOS doesn't know QOI or every Netpbm flavour; teach it. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.qoiformat.qoi</string>
			<key>UTTypeDescription</key>
			<string>QOI image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qoi</string>
				</array>
				<key>public.mime-type</key>
				<string>image/qoi</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.pnm</string>
			<key>UTTypeDescription</key>
			<string>Netpbm image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.image</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pnm</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Right-click › Quick Actions (Services) › Convert with ConvertAll. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Convert with ConvertAll</string>
			</dict>
			<key>NSMessage</key>
			<string>convertFiles</string>
			<key>NSPortName</key>
			<string>ConvertAll</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
